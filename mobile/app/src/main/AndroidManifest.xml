<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 起通知是运行时权限，不给就什么都不弹 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台那条长连接：Android 14 起前台服务必须声明类型，聊天这种收消息的就是 remoteMessaging -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <application android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatMobile"
        android:usesCleartextTraffic="true">
        <!-- 开发机上后端是 http://192.168.x.x:8081，走明文是常态，usesCleartextTraffic 就是为这个开的 -->
        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 主界面是底部四 tab 那个壳；exported=false，adb 起不了它，只能从登录页跳 -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 我页往下两屏：设置页、个人信息页。都只从应用内跳，不对外暴露 -->
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".FontSizeActivity" android:exported="false" />
        <activity android:name=".ProfileActivity" android:exported="false" />
        <!-- 改一个字段的整页 -->
        <activity android:name=".EditFieldActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 通讯录里「群聊」那一档点进去的那页 -->
        <activity android:name=".GroupListActivity" android:exported="false" />
        <!-- 聊天页右上 ⋯ 进来的那页 -->
        <activity android:name=".ChatInfoActivity" android:exported="false" />
        <!-- 群成员宫格最后那颗 ＋ 点进来的一页 -->
        <activity android:name=".AddMembersActivity" android:exported="false" />
        <!-- 聊天里点对方头像进来的那页（对应桌面端好友信息弹框） -->
        <activity android:name=".PersonActivity" android:exported="false" />
        <!-- 工作台某个入口点进去的那页（搜索 + 分类页签 + 卡片列表） -->
        <activity android:name=".WorkListActivity" android:exported="false" />
        <!-- 后台收消息那条：没有系统推送，只能自己把网关的 WebSocket 挂在这儿 -->
        <service android:name=".NotifyService" android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>

</manifest>
