<?xml version="1.0" encoding="utf-8"?>
<!-- 微信会话行：头像 40 方角、名字+摘要两行、右上角时间、右侧红底白字角标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/surface"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">

    <TextView android:id="@+id/ava"
        android:layout_width="42dp" android:layout_height="42dp"
        android:gravity="center" android:textSize="18sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:background="@color/brand" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="11dp"
        android:orientation="vertical">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/ink"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/last"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp" android:textColor="@color/ink_dim"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/ink_dim" />
        <TextView android:id="@+id/unread"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/unread_badge"
            android:minWidth="18dp" android:gravity="center"
            android:paddingStart="5dp" android:paddingEnd="5dp"
            android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
