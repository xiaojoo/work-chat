<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/nb_bg_3">

    <!-- 顶栏对齐桌面端标题栏那一条：nb-bg-shell，标题 16px/600 -->
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="50dp"
        android:background="@color/shell">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="微信" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/ink" />
    </FrameLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent" android:layout_height="32dp"
        android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
        android:background="@drawable/search_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="@color/ink_dim2"
        android:drawablePadding="6dp"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:singleLine="true"
        android:hint="搜索" android:textSize="13sp" android:textColor="@color/ink"
        android:textColorHint="@color/ink_dim2" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="4dp" android:clipToPadding="false" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:textSize="11sp" android:textColor="@color/ink_dim2" />

</LinearLayout>
