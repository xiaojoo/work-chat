<?xml version="1.0" encoding="utf-8"?>
<!-- 消息行照桌面端 .msg：头像 34 方角、气泡圆角、行间距。
     群聊才在气泡上方印发送人名（对应桌面端 .msg-who），单聊不印。
     名字是行内那一列的头，不是整行之上的一行——这样名字的顶边和头像的顶边在同一条线上（行改顶部对齐）。
     尾巴仍然夹在气泡和头像之间、跟着气泡垂直居中：它和气泡同属 line 这一横排，不受名字影响。
     时间不在每条底下，见 item_time.xml。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 两侧头像，和桌面端 .msg-ava 一样：对方在左、自己在右，另一侧留空 -->
        <TextView
            android:id="@+id/avaL"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/ava_square"
            android:visibility="gone" />

        <!-- 名字 + 气泡这一列；有名字时整行顶部对齐，头像就和名字顶边平齐 -->
        <LinearLayout
            android:id="@+id/col"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/who"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:layout_marginTop="-2.5dp"
                android:textSize="11sp"
                android:textColor="@color/ink_dim"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/tailL"
                    android:layout_width="6dp"
                    android:layout_height="10dp"
                    android:src="@drawable/tail_left"
                    android:contentDescription=""
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bubble_other"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:gravity="center_vertical"
                    android:minHeight="34dp"
                    android:textSize="14sp"
                    android:textColor="@color/ink"
                    android:maxWidth="260dp" />

                <ImageView
                    android:id="@+id/tailR"
                    android:layout_width="6dp"
                    android:layout_height="10dp"
                    android:src="@drawable/tail_right"
                    android:contentDescription=""
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 自己这一条的状态：发送中 / 已送达 / 没发出去。
                 放在气泡下面而不是右边：右边是尾巴和头像那一列，塞进去会把已经认可的行宽几何顶开。
                 对方那条、以及从历史里翻出来的旧条一律不显示（回执不落库，刷新就没有，和桌面端同一口径）。
                 已读不做：两端现在都没有发 MESSAGE_READ 的一方，加了就是一颗永远不亮的字。 -->
            <TextView
                android:id="@+id/st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/ink_dim2"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/avaR"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/ava_square"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
