<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="10dp" android:paddingBottom="10dp">

        <TextView android:id="@+id/ava"
            android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:background="@drawable/ava_square" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/name"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="16sp" android:textColor="@color/ink"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/sub"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:minHeight="16dp"
                android:textSize="12sp" android:textColor="@color/ink_dim"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <View android:id="@+id/online"
            android:layout_width="8dp" android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:background="@color/ok" android:visibility="gone" />
    </LinearLayout>

    <!-- 一行一条，靠这根从文字起头的浅线分开，不再是两张卡片叠在一起。
         0.5dp 在这台机（dpr 2.75）落到 1px；原来 1dp 实渲 3px，压不住"底部那条边错位" -->
    <View android:id="@+id/line"
        android:layout_width="match_parent" android:layout_height="0.5dp"
        android:layout_marginStart="64dp"
        android:background="@color/line_soft" />
</LinearLayout>
