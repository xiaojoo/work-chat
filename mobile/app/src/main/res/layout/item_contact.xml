<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@color/surface"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="8dp" android:paddingBottom="8dp">

    <TextView android:id="@+id/ava"
        android:layout_width="36dp" android:layout_height="36dp"
        android:gravity="center" android:textSize="16sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:background="@color/brand" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="11dp" android:orientation="vertical">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textColor="@color/ink"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/ink_dim"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <View android:id="@+id/online"
        android:layout_width="8dp" android:layout_height="8dp"
        android:background="@color/brand" android:visibility="gone" />

</LinearLayout>
