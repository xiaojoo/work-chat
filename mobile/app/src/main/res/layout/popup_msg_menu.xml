<?xml version="1.0" encoding="utf-8"?>
<!-- 长按消息弹出的那一块：白底 + 6dp 圆角（menu_bg），五列一行、两行十项。
     上下各留一颗三角的位子，代码里按"底下放不放得下"只点亮其中一颗，
     并把它的左右位置挪到正对着那条消息的气泡。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView android:id="@+id/tipUp"
        android:layout_width="12dp" android:layout_height="6dp"
        android:src="@drawable/tip_up_menu" android:visibility="gone"
        android:contentDescription="" />

    <GridLayout android:id="@+id/grid"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:columnCount="5"
        android:background="@drawable/menu_bg"
        android:paddingStart="4dp" android:paddingEnd="4dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" />

    <ImageView android:id="@+id/tipDown"
        android:layout_width="12dp" android:layout_height="6dp"
        android:src="@drawable/tip_down_menu" android:visibility="gone"
        android:contentDescription="" />
</LinearLayout>
