<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/nb_bg_3" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 「我」顶部这张卡：底对齐桌面端标题栏那层 shell，头像 38 方角 9 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@color/shell"
            android:padding="16dp">
            <TextView android:id="@+id/ava"
                android:layout_width="52dp" android:layout_height="52dp"
                android:gravity="center" android:textSize="20sp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="@drawable/ava_square" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/account"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp" android:textColor="@color/ink_dim"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/fields"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" android:background="@color/surface" />

        <Button android:id="@+id/logout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:background="@color/surface"
            android:textColor="@color/danger" android:textSize="14sp"
            android:text="退出登录" />

        <TextView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:textSize="11sp" android:textColor="@color/ink_dim2" />

    </LinearLayout>
</ScrollView>
