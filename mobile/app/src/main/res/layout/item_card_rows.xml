<?xml version="1.0" encoding="utf-8"?>
<!-- 和 item_card 同一张卡（同样的小标题、同样的格子上排法），但两处不一样：
     ① 不用 card_round 那 12dp 圆角——聊天信息这一屏上下都是贴边的白面，圆角会在四个角
        啃进去一块（实测卡片上下边缘那行白区从 x=28 才开始，往下到 y≈265 才回到 x=0），
        看着像留了 padding；
     ② 里面不摆 GridLayout：带权重的 GridLayout 不满一行时会把整行宽度分给现有几格，
        格子被推到中间去。这里按 5 个一行切成横排，每行 weightSum=5、每格权重 1，
        缺的格不补，最后一行也从左边铺。
     只给聊天信息页用；工作台仍走 item_card 那份圆角卡。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface">

    <TextView android:id="@+id/cap"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="14dp" android:paddingBottom="2dp"
        android:textSize="13sp" android:textColor="@color/ink_dim2" />

    <LinearLayout android:id="@+id/gridRows"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="6dp" />
</LinearLayout>
