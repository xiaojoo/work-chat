<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:minHeight="86dp" android:orientation="vertical" android:gravity="center"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="12dp" android:paddingBottom="12dp">

    <ImageView android:id="@+id/ic"
        android:layout_width="26dp" android:layout_height="26dp"
        android:contentDescription="" />

    <TextView android:id="@+id/name"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp" android:textColor="@color/ink"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
