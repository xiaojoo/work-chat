<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <!-- 手机上这就是返回键，桌面端没有这一颗 -->
        <Button
            android:id="@+id/back"
            style="@style/BackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:textSize="20sp"
            android:text="‹" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右上这颗对应微信聊天页的 ⋯，进去是「聊天信息」 -->
        <Button
            android:id="@+id/more"
            style="@style/BackBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:textSize="20sp"
            android:text="⋯" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- 输入这一条照微信那排：语音 / 输入框（右端一个麦克风）/ 表情 / ＋，最右留着「发送」。
         语音和麦克风后端没有接口，所以画出来是灰的、点不动——和长按菜单"十项全摆八项灰"同一口径。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/nb_bg_3"
        android:padding="8dp">

        <ImageView
            android:id="@+id/voiceBtn"
            android:layout_width="40dp" android:layout_height="40dp"
            android:padding="7dp"
            android:src="@drawable/ic_voice"
            android:alpha="0.4"
            android:contentDescription="语音（后端没有语音消息）" />

        <!-- 输入框 + 框内右端那颗麦克风 -->
        <FrameLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:maxLines="4"
                android:background="@drawable/field_pill"
                android:paddingStart="12dp" android:paddingEnd="40dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:textSize="15sp"
                android:inputType="textShortMessage|textMultiLine|textCapSentences"
                android:hint="说点什么" />

            <ImageView
                android:id="@+id/micBtn"
                android:layout_width="26dp" android:layout_height="26dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_mic"
                android:alpha="0.4"
                android:contentDescription="语音输入（后端没有这个接口）" />
        </FrameLayout>

        <!-- 按下不亮 ripple：这排是常驻控件，一亮只是"按到了"的多余回声 -->
        <ImageView
            android:id="@+id/emojiBtn"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:padding="7dp"
            android:src="@drawable/ic_emoji"
            android:contentDescription="表情" />

        <!-- ＋ 和「发送」共用一格：输入框没字是 ＋，一有字发送就占掉这一格（＋ 同时收掉，
             不留一颗被盖住还点得着的钮）。槽位定宽，切换时这一排别的东西不跳位 -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp">

            <ImageView
                android:id="@+id/plusBtn"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center"
                android:padding="7dp"
                android:src="@drawable/ic_plus_circle"
                android:contentDescription="添加" />

            <Button
                android:id="@+id/send"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/btn_brand"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:visibility="gone"
                android:text="发送" />
        </FrameLayout>
    </LinearLayout>

    <!-- 面板：表情是一排字格；＋ 那八颗格子按图全摆，接不了接口的画淡、点不动 -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nb_bg_3"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/emojiScroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxHeight="200dp" android:visibility="gone">

            <GridLayout android:id="@+id/emojiGrid"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="7" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="6dp" android:paddingBottom="6dp" />
        </ScrollView>

        <GridLayout android:id="@+id/plusGrid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="4" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="14dp" android:paddingBottom="14dp" android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
