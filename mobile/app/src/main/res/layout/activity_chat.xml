<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <!-- 手机上这就是返回键，桌面端没有这一颗 -->
        <Button
            android:id="@+id/back"
            style="@style/BackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:textSize="20sp"
            android:text="‹" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右上这颗对应微信聊天页的 ⋯，进去是「聊天信息」 -->
        <Button
            android:id="@+id/more"
            style="@style/BackBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:textSize="20sp"
            android:text="⋯" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- 输入这块照图分两行：上面一行 = 输入框 + 「发送」，下面一行 = 工具栏（独立一行，六颗均分）。
         「发送」只在输入框有字时出现（上一轮点名的规则），出现就在输入框右边。
         后端没有的能力（语音、拍摄、贴纸）画淡 0.4、不给点——和长按菜单"十项全摆八项灰"同一口径。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@color/nb_bg_3"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="8dp" android:paddingBottom="4dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:maxLines="4"
            android:background="@drawable/field_pill"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:inputType="textShortMessage|textMultiLine|textCapSentences"
            android:hint="说点什么" />

        <!-- 「发送」常驻右边：没字时是灰蓝的不可选中态（只换底色 + 不给点），不是消失 -->
        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="68dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_brand"
            android:stateListAnimator="@null"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:enabled="false"
            android:text="发送" />
    </LinearLayout>

    <!-- 工具栏：独立一行，六颗等宽铺满。都不带按下高亮（上一轮点名的规则）；
         颜色统一到 ink 那颗令牌——原来表情和 ＋ 是 ink_dim，和旁边三颗描 ink 色的不在一个深浅上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/nb_bg_3"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="2dp" android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/micBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_mic"
            android:tint="@color/ink"
            android:alpha="0.4"
            android:contentDescription="语音输入（后端没有语音消息）" />

        <ImageView
            android:id="@+id/imageBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_wb_image"
            android:tint="@color/ink"
            android:contentDescription="相册" />

        <ImageView
            android:id="@+id/cameraBtn"
            android:layout_width="0dp" android="40dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_camera"
            android:tint="@color/ink"
            android:alpha="0.4"
            android:contentDescription="拍摄（没接相机）" />

        <ImageView
            android:id="@+id/stickerBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_sticker"
            android:tint="@color/ink"
            android:alpha="0.4"
            android:contentDescription="贴纸（后端没有贴纸）" />

        <ImageView
            android:id="@+id/emojiBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_emoji"
            android:tint="@color/ink"
            android:contentDescription="表情" />

        <ImageView
            android:id="@+id/plusBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_plus_circle"
            android:tint="@color/ink"
            android:contentDescription="添加" />
    </LinearLayout>

    <!-- 面板：表情是一排字格；＋ 那八颗格子按图全摆，接不了接口的画淡、点不动 -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nb_bg_3"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/emojiScroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxHeight="200dp" android:visibility="gone">

            <GridLayout android:id="@+id/emojiGrid"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="7" android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="6dp" android:paddingBottom="6dp" />
        </ScrollView>

        <GridLayout android:id="@+id/plusGrid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="4" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="14dp" android:paddingBottom="14dp" android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
