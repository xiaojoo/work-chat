<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <!-- 手机上这就是返回键，桌面端没有这一颗 -->
        <Button
            android:id="@+id/back"
            style="@style/BackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:textSize="20sp"
            android:text="‹" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 会话内检索的入口。摆在对象表面上（这条会话的顶栏），不藏进长按菜单里那颗「搜一搜」 -->
        <ImageView
            android:id="@+id/searchBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            android:tint="@color/ink"
            android:contentDescription="在本会话中搜索" />

        <!-- 右上这颗对应微信聊天页的 ⋯，进去是「聊天信息」 -->
        <Button
            android:id="@+id/more"
            style="@style/BackBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:textSize="20sp"
            android:text="⋯" />
    </LinearLayout>

    <!-- 会话内检索：上面那颗放大镜点开这两块。
         搜索条和命中面板都插在标题栏与消息列表之间——列表只是被压矮，一条消息也不会因此看不见。 -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/shell"
        android:paddingStart="8dp" android:paddingEnd="6dp"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:drawableStart="@drawable/ic_search"
            android:drawableTint="@color/ink_dim2"
            android:drawablePadding="6dp"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:hint="在本会话中搜索"
            android:textSize="14sp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_dim2" />

        <!-- 清空那颗只在有字时给（没字时点它没有对象），但它占的格子一直在，行不抖 -->
        <Button
            android:id="@+id/searchClear"
            style="@style/BackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:textSize="16sp"
            android:textColor="@color/ink_dim"
            android:text="✕" />

        <Button
            android:id="@+id/searchCancel"
            style="@style/BackBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textSize="14sp"
            android:text="取消" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- 后端报的实数：命中几条、翻了多少条、多久、用的哪个后端。
             扫到窗口头还没扫完时下面那句改口说"只翻了最近 N 天"，不能把"没搜到"演成"没有" -->
        <TextView
            android:id="@+id/searchMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:textSize="11sp"
            android:textColor="@color/ink_dim2" />

        <TextView
            android:id="@+id/searchNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/warn"
            android:visibility="gone" />

        <!-- 面板统一固定高，只有这一列内部滚，外面整页永不滚 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchList"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/sumRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp">

            <Button
                android:id="@+id/sumBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:background="@drawable/btn_brand"
                android:stateListAnimator="@null"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:text="AI 归纳这批" />

            <TextView
                android:id="@+id/sumMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:textColor="@color/ink_dim2" />
        </LinearLayout>

        <TextView
            android:id="@+id/sumOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/search_bg"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:visibility="gone" />

        <!-- 面板和消息区同为白底，靠这条分界；它跟着面板一起出现，收起时不会留下一根没人认领的线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="6dp"
            android:background="@color/line" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- 输入这块照图分两行：上面一行 = 输入框 + 「发送」，下面一行 = 工具栏（独立一行，六颗均分）。
         「发送」只在输入框有字时出现（上一轮点名的规则），出现就在输入框右边。
         后端没有的能力（语音、拍摄、贴纸）画淡 0.4、不给点——和长按菜单"十项全摆八项灰"同一口径。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@color/nb_bg_3"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="8dp" android:paddingBottom="4dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:maxLines="4"
            android:background="@drawable/field_pill"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:textSize="15sp"
            android:inputType="textShortMessage|textMultiLine|textCapSentences"
            android:hint="说点什么" />

        <!-- 「发送」常驻右边：没字时是灰蓝的不可选中态（只换底色 + 不给点），不是消失 -->
        <Button
            android:id="@+id/send"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="68dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_brand"
            android:stateListAnimator="@null"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:enabled="false"
            android:text="发送" />
    </LinearLayout>

    <!-- 工具栏：独立一行，六颗等宽铺满。都不带按下高亮（上一轮点名的规则）；
         颜色统一到 ink 那颗令牌——原来表情和 ＋ 是 ink_dim，和旁边三颗描 ink 色的不在一个深浅上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/nb_bg_3"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="2dp" android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/micBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_mic"
            android:tint="@color/ink"
            android:alpha="0.4"
            android:contentDescription="语音输入（后端没有语音消息）" />

        <ImageView
            android:id="@+id/imageBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_wb_image"
            android:tint="@color/ink"
            android:contentDescription="相册" />

        <ImageView
            android:id="@+id/cameraBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_camera"
            android:tint="@color/ink"
            android:alpha="0.4"
            android:contentDescription="拍摄（没接相机）" />

        <ImageView
            android:id="@+id/stickerBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_sticker"
            android:tint="@color/ink"
            android:alpha="0.4"
            android:contentDescription="贴纸（后端没有贴纸）" />

        <ImageView
            android:id="@+id/emojiBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_emoji"
            android:tint="@color/ink"
            android:contentDescription="表情" />

        <ImageView
            android:id="@+id/plusBtn"
            android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_plus_circle"
            android:tint="@color/ink"
            android:contentDescription="添加" />
    </LinearLayout>

    <!-- 面板：表情是一排字格；＋ 那八颗格子按图全摆，接不了接口的画淡、点不动 -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nb_bg_3"
        android:visibility="gone">

        <!-- 两块面板同一高 220dp（＋ 那两行 96dp + 上下 14dp 内边距正好 220，表情照这个数钉死）。
             表情排成轮播那样：一页 4 行 × 7 列 = 28 个，装不下的往左右翻，松手吸附到整页 -->
        <com.chat.mobile.PageScroller
            android:id="@+id/emojiScroll"
            android:layout_width="match_parent" android:layout_height="220dp"
            android:scrollbars="none" android:visibility="gone">

            <LinearLayout android:id="@+id/emojiPages"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingTop="6dp" android:paddingBottom="6dp" />
        </com.chat.mobile.PageScroller>

        <GridLayout android:id="@+id/plusGrid"
            android:layout_width="match_parent" android:layout_height="220dp"
            android:columnCount="4" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="14dp" android:paddingBottom="14dp" android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
