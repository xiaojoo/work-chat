<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天信息页顶上的人：44 方头像 + 下面一行名字 + 压在头像右下角的角色角标（照桌面端 .gs-cell/.gs-tag）。
     宽度由外面给：ChatInfoActivity 按 5 个一行切横排，每格权重 1，所以这里 root 的宽度只是占位。
     名字框吃满整格，不跟头像一样宽——不然 "probeA" 会被截成 probeA…。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:minHeight="78dp" android:orientation="vertical" android:gravity="center"
    android:paddingTop="8dp" android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="44dp" android:layout_height="44dp">

        <TextView android:id="@+id/ava"
            android:layout_width="44dp" android:layout_height="44dp"
            android:gravity="center" android:textSize="16sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:background="@drawable/ava_square" />

        <TextView android:id="@+id/tag"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:paddingStart="2dp" android:paddingEnd="2dp"
            android:textSize="8sp" android:textColor="#FFFFFF"
            android:background="@drawable/tag_owner" android:visibility="invisible" />
    </FrameLayout>

    <TextView android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
        android:layout_marginTop="5dp" android:gravity="center"
        android:textSize="11sp" android:textColor="@color/ink_dim"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
