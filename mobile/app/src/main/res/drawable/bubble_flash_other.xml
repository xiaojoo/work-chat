<?xml version="1.0" encoding="utf-8"?>
<!-- 对方那条的命中闪光：同 bubble_flash_self，只是里面那颗是 nb_bg_3。
     光圈那颗令牌两端共用（hit_ring），浅底/深底各按同一条混法算，不另发明 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hit_ring" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_bg_3" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
