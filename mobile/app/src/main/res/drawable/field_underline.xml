<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框只留一根下划线：一条压在底边的实心线。
     不用负 inset——实测那套在这台机上上下两条都会画出来。
     0.5dp：这台机 dpr 2.75，1dp 实渲 3px，0.5dp 才落到 1px（和列表那些线同一口径） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom" android:height="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
        </shape>
    </item>
</layer-list>
