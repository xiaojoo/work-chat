<?xml version="1.0" encoding="utf-8"?>
<!-- 列表行底：桌面端 .row 是 8px 圆角、透明底，hover 才填 row-hover。
     手机上没有 hover，按下给同一档色，选中给 .row.active 那档 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="@color/row_active" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/row_hover" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
