<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChatMobile" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- 底部一个 tab：竖排、占等宽、整块可点 -->
    <style name="TabItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TabIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="TabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/tab_tint</item>
    </style>

    <!-- 滑开行之后露出的动作按钮：白字 15sp 居中，宽度由每一颗自己写死（定宽，跟着拖拽拉伸的那种不要） -->
    <style name="SwipeAct">
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 底部面板的一行：整行可点、字居中、高度按拇指下限给到 54dp -->
    <style name="SheetItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SheetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line_soft</item>
    </style>

    <!-- 顶栏那颗返回 ‹：无边框只留按下反馈。原生 Button 的灰底在浅灰顶栏上是一块明显的方疙瘩 -->
    <style name="BackBtn" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <!-- Borderless 也带一层按下 ripple（实测按住 ‹ 那 48dp 里有 10944 个像素在变）。
             按「按钮的按下高亮去掉」铺一层空底把它顶掉 -->
        <item name="android:background">@null</item>
    </style>

    <!-- 微信式的行：白底、左图标/头像、中间两行文字、右箭头，底部一条分隔线 -->
    <style name="RowItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/surface</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
